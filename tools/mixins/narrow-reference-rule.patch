+    #[derive(Debug, PartialEq)]
+    pub struct Failure(pub String);
+    impl From<&'static str> for Failure {{ fn from(s: &'static str) -> Self {{ Failure(format!("converted {{s}}")) }} }}
+    pub struct Engine(pub i32);
+    impl Engine {{ pub fn go(self, x: i32) -> i32 {{ mark("go"); self.0 + x }} }}
