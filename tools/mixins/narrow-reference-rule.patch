+                    else {
+                        return Truth::Unknown;
+                    };
+                    let fold = |decisive: Truth, otherwise: Truth| {
+                        let mut unknown = false;
+                        for meta in &inner {
+                            match self.eval(meta, features) {
+                                truth if truth == decisive => return decisive,
+                                Truth::Unknown => unknown = true,
+                                _ => {}
+                            }
+                        }
+                        if unknown { Truth::Unknown } else { otherwise }
+                    };
+                    if list.path.is_ident("all") {
+                        fold(Truth::No, Truth::Yes)
+                    } else if list.path.is_ident("any") {
+                        fold(Truth::Yes, Truth::No)
+                    } else if list.path.is_ident("not") && inner.len() == 1 {
+                        match self.eval(&inner[0], features) {
+                            Truth::Yes => Truth::No,
+                            Truth::No => Truth::Yes,
+                            Truth::Unknown => Truth::Unknown,
+                        }
+                    } else {
+                        Truth::Unknown
+                    }
+                }
+            }
+        }
+
+        /// Reads a source file under this set: see the module documentation.
+        pub fn parse_file(&self, source: &str, features: bool) -> syn::Result<syn::File> {
+            let mut file = syn::parse_file(source)?;
+            match self.apply_attrs(&mut file.attrs, features) {
+                // An inactive file compiles to nothing.
+                Truth::No => {
+                    file.items.clear();
+                    file.attrs.clear();
+                }
+                _ => Reduce(self, features).visit_file_mut(&mut file),
+            }
+            Ok(file)
+        }
+
+        /// Applies the `cfg` and `cfg_attr` attributes in `attrs`: whether the node they sit on is
+        /// compiled (`Yes`, with the attributes rewritten), is not (`No`), or cannot be told
+        /// (`Unknown`, the undecided attributes kept).
+        fn apply_attrs(&self, attrs: &mut Vec<Attribute>, features: bool) -> Truth {
+            let mut result = Truth::Yes;
+            let mut out = Vec::with_capacity(attrs.len());
+            let mut pending: Vec<Attribute> = std::mem::take(attrs);
+            pending.reverse();
+            while let Some(attr) = pending.pop() {
+                if attr.path().is_ident("cfg") {
+                    match attr.parse_args::<Meta>().map(|m| self.eval(&m, features)) {
+                        Ok(Truth::Yes) => {}
+                        Ok(Truth::No) => {
+                            result = Truth::No;
+                            out.push(attr);
+                        }
+                        _ => {
+                            if result == Truth::Yes {
+                                result = Truth::Unknown;
+                            }
+                            out.push(attr);
+                        }
+                    }
+                } else if attr.path().is_ident("cfg_attr") {
+                    let parsed = attr
+                        .parse_args_with(Punctuated::<Meta, Token![,]>::parse_terminated)
+                        .ok()
+                        .filter(|args| args.len() >= 2);
+                    let Some(args) = parsed else {
+                        if result == Truth::Yes {
+                            result = Truth::Unknown;
+                        }
+                        out.push(attr);
+                        continue;
+                    };
+                    match self.eval(&args[0], features) {
+                        Truth::No => {}
+                        Truth::Yes => {
+                            let style = attr.style;
+                            for meta in args.iter().skip(1).rev() {
+                                let mut expanded: Attribute = syn::parse_quote!(#[#meta]);
+                                expanded.style = style;
+                                pending.push(expanded);
+                            }
+                        }
+                        Truth::Unknown => {
+                            if result == Truth::Yes {
+                                result = Truth::Unknown;
+                            }
+                            out.push(attr);
+                        }
+                    }
+                } else {
+                    out.push(attr);
+                }
+            }
+            *attrs = out;
+            result
+        }
+
+        /// Whether a node with these attributes stays: it does unless a `cfg` turns it off. The
+        /// attributes are rewritten on the way.
+        fn keep(&self, attrs: &mut Vec<Attribute>, features: bool) -> bool {
+            self.apply_attrs(attrs, features) != Truth::No
+        }
+    }
+
+    /// The cfg names that follow from the validated target, taken from the printed set and
+    /// compared on their full values.
+    const TARGET_FACTS: [&str; 10] = [
+        "target_os",
+        "target_family",
+        "unix",
+        "windows",
+        "target_arch",
+        "target_pointer_width",
+        "target_endian",
+        "target_env",
+        "target_vendor",
+        "target_abi",
+    ];
+
+    /// `name` or `name="value"` as the one string the set holds; `None` for any other shape.
+    fn option_key(meta: &Meta) -> Option<String> {
+        match meta {
+            Meta::Path(path) => path.get_ident().map(|i| i.unraw().to_string()),
+            Meta::NameValue(nv) => {
+                let name = nv.path.get_ident()?.unraw();
+                match &nv.value {
+                    Expr::Lit(lit) => match &lit.lit {
+                        Lit::Str(value) => Some(format!("{name}={:?}", value.value())),
+                        _ => None,
+                    },
+                    _ => None,
+                }
+            }
+            Meta::List(_) => None,
+        }
+    }
+
+    struct Reduce<'a>(&'a CfgSet, bool);
+
+    impl VisitMut for Reduce<'_> {
+        fn visit_file_mut(&mut self, file: &mut syn::File) {
+            file.items
+                .retain_mut(|item| item_attrs(item).is_none_or(|attrs| self.keep(attrs)));
