+                syn::Fields::Named(f) => drop_inactive(&mut f.named),
+                syn::Fields::Unnamed(f) => drop_inactive(&mut f.unnamed),
+                syn::Fields::Unit => {}
+            }
+        }
+    }
+
+    fn item_attrs(item: &mut syn::Item) -> Option<&mut Vec<Attribute>> {
+        use syn::Item::*;
+        Some(match item {
+            Const(i) => &mut i.attrs,
+            Enum(i) => &mut i.attrs,
+            ExternCrate(i) => &mut i.attrs,
+            Fn(i) => &mut i.attrs,
+            ForeignMod(i) => &mut i.attrs,
+            Impl(i) => &mut i.attrs,
+            Macro(i) => &mut i.attrs,
+            Mod(i) => &mut i.attrs,
+            Static(i) => &mut i.attrs,
+            Struct(i) => &mut i.attrs,
+            Trait(i) => &mut i.attrs,
+            TraitAlias(i) => &mut i.attrs,
+            Type(i) => &mut i.attrs,
+            Union(i) => &mut i.attrs,
+            Use(i) => &mut i.attrs,
+            _ => return None,
+        })
+    }
+
+    fn expr_attrs(expr: &mut Expr) -> Option<&mut Vec<Attribute>> {
+        use syn::Expr::*;
+        Some(match expr {
+            Array(e) => &mut e.attrs,
+            Assign(e) => &mut e.attrs,
+            Async(e) => &mut e.attrs,
+            Await(e) => &mut e.attrs,
