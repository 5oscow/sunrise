+            Infer(e) => &mut e.attrs,
+            Let(e) => &mut e.attrs,
+            Lit(e) => &mut e.attrs,
+            Loop(e) => &mut e.attrs,
+            Macro(e) => &mut e.attrs,
+            Match(e) => &mut e.attrs,
+            MethodCall(e) => &mut e.attrs,
+            Paren(e) => &mut e.attrs,
+            Path(e) => &mut e.attrs,
+            Range(e) => &mut e.attrs,
+            RawAddr(e) => &mut e.attrs,
+            Reference(e) => &mut e.attrs,
