+    /// A wrap of the function `callee`, whose argument is bound as `ty` and whose result is `out`.
+    fn scale_row(callee: &str, ty: &str, out: &str) -> String {
+        format!(
+            r#"
+    [[injection]]
+    id="wrap"
+    target="fixture_game::run"
+    kind="WRAP_OPERATION"
+    selector="{callee}"
+    require=1
+    ordinal=0
+    helper="wrap_scale.rs"
+    bindings=[{{name="x",ty="{ty}",value="$arg0"}},{{name="original",ty="impl FnOnce({ty}) -> {out}",value="$operation"}}]
+    "#
+        )
+    }
+    fn scale_fixture(body: &str, callee: &str, ty: &str, out: &str) -> Fixture {
+        let f = fixture(body, &scale_row(callee, ty, out));
+        fs::write(
+            f.mods.join("alpha/wrap_scale.rs"),
+            format!("fn wrap_scale(x: {ty}, original: impl FnOnce({ty}) -> {out}) -> {out} {{ original(x) }}"),
+        )
+        .unwrap();
