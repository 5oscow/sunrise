+    }
+
+    impl Reduce<'_> {
+        fn keep(&self, attrs: &mut Vec<Attribute>) -> bool {
+            self.0.keep(attrs, self.1)
+        }
+        fn fields(&self, fields: &mut syn::Fields) {
