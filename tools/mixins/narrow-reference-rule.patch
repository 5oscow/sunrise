+pub mod cfg {
+    //! The `cfg` set of the build a workspace is compiled in, and the pass that applies it.
+    //!
+    //! Given a set (`--cfg` on the command line, in rustc's own spelling: `unix`, `feature="x"`), a
+    //! parsed source file is reduced to what that build compiles: items, statements, fields, variants,
+    //! parameters and match arms under an inactive `cfg` are dropped, an active `cfg` attribute is
+    //! removed, and `cfg_attr` is expanded. Every layer after the parse (index, planner, transform)
+    //! then sees the same source. A predicate the set cannot decide (`version(..)`, a path, a literal
+    //! that is not a string) leaves its attribute in place, so the usual `E_UNSUPPORTED_CFG` refusal
+    //! still applies to it. With no set, nothing is reduced.
+
+    use crate::{Diagnostic, Result};
+    use std::collections::BTreeSet;
+    use syn::ext::IdentExt;
+    use syn::{
+        Attribute, Expr, Lit, Meta, Token,
+        punctuated::Punctuated,
+        visit_mut::{self, VisitMut},
+    };
+
+    /// The cfg options of one build: names (`unix`) and name/value pairs (`feature="x"`). The set
+    /// decides only what the signed build vouches for: `feature` in the `--features-of` package,
+    /// `test` (the patch library is not a test build) and the target facts, which follow from the
+    /// target (see [`TARGET_FACTS`]). Anything else is `Unknown` whether the set lists it or not,
+    /// since it depends on compiler flags or on the original build's build script.
+    #[derive(Debug, Clone, Default, PartialEq, Eq)]
+    pub struct CfgSet {
+        options: BTreeSet<String>,
+        /// The names the options carry, with any value.
+        names: BTreeSet<String>,
+        features_of: Option<String>,
+    }
+
+    #[derive(Clone, Copy, PartialEq, Eq)]
+    enum Truth {
+        Yes,
+        No,
+        Unknown,
+    }
+
+    impl CfgSet {
+        /// Parses options in rustc's `--cfg` spelling.
+        pub fn parse(options: &[String], features_of: Option<&str>) -> Result<Self> {
+            let mut set = BTreeSet::new();
+            for option in options {
+                let meta = syn::parse_str::<Meta>(option).map_err(|e| {
+                    Diagnostic::new(
+                        "E_CFG",
+                        format!("--cfg {option:?} is not a cfg option: {e}"),
+                    )
+                })?;
+                set.insert(match option_key(&meta) {
+                    Some(key) => key,
+                    None => {
+                        return Err(Diagnostic::new(
+                            "E_CFG",
+                            format!("--cfg {option:?} is not `name` or `name=\"value\"`"),
+                        ));
+                    }
+                });
+            }
+            if features_of.is_none() && set.iter().any(|option| option.starts_with("feature=")) {
+                return Err(Diagnostic::new(
+                    "E_CFG",
+                    "a `feature` option belongs to one package's features: name it with --features-of",
+                ));
+            }
+            Ok(Self {
+                names: set
+                    .iter()
+                    .map(|key| key.split('=').next().unwrap().to_owned())
+                    .collect(),
+                options: set,
+                features_of: features_of.map(str::to_owned),
+            })
+        }
+
+        /// The options in a form [`CfgSet::parse`] reads back, sorted.
+        pub fn options(&self) -> Vec<String> {
+            self.options.iter().cloned().collect()
+        }
+
+        /// The package whose own files decide `feature` predicates; in any other, they stay undecided.
+        pub fn features_of(&self) -> Option<&str> {
+            self.features_of.as_deref()
+        }
+
+        fn eval(&self, meta: &Meta, features: bool) -> Truth {
+            match meta {
+                Meta::Path(path) if path.is_ident("true") => Truth::Yes,
+                Meta::Path(path) if path.is_ident("false") => Truth::No,
+                Meta::Path(_) | Meta::NameValue(_) => match option_key(meta) {
+                    Some(key) if key.starts_with("feature=") && !features => Truth::Unknown,
+                    Some(key) => {
+                        let name = key.split('=').next().unwrap();
+                        let present = self.options.contains(&key);
+                        let decided = match name {
+                            "feature" => true,
+                            "test" => {
+                                return if key == "test" {
+                                    Truth::No
+                                } else {
+                                    Truth::Unknown
+                                };
+                            }
+                            // The printed target set is complete for these names: absent is off.
+                            _ if TARGET_FACTS.contains(&name) => {
+                                present
+                                    || self.names.contains(name)
+                                    || (matches!(name, "unix" | "windows")
