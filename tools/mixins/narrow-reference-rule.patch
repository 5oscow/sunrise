+    #[test]
+    fn an_argument_carrying_a_try_or_a_block_is_refused() {
+        // The wrapper's declared type is an expected type for the argument: `f32` on
+        // `scale(default_value(0.1)?)` converts `0.1` through `f32` (0.1 becomes
+        // 0.10000000149011612), and the never-type fallback of `fail()?` in a 2024 diverging
+        // `if` changes with a declared `i64`. A `?` (or a block) in an argument is refused.
+        for (body, callee, ty, out) in [
+            (
+                "Ok(scale(default_value(0.1)?) as i32)",
+                "scale",
+                "f32",
+                "f64",
+            ),
+            (
+                "Ok(scale(default_value(0.1)?) as i32)",
+                "scale",
+                "f64",
+                "f64",
+            ),
+            (
+                "Ok(width(if ok { return Ok(7) } else { fail()? }) as i32)",
+                "width",
+                "i64",
+                "usize",
+            ),
+            ("Ok(scale(unsafe { 1i32 }) as i32)", "scale", "i32", "f64"),
+            ("Ok(scale(const { 1i32 }) as i32)", "scale", "i32", "f64"),
+            (
+                "Ok(scale(try { 1i32 }.unwrap()) as i32)",
+                "scale",
+                "i32",
+                "f64",
+            ),
+        ] {
+            let f = scale_fixture(body, callee, ty, out);
+            let e = plan_error(&f);
+            assert_eq!(e.code, "E_UNSUPPORTED_CONTROL_FLOW", "{body} {ty}: {e}");
+        }
+    }
