+                .into_iter()
+                .filter_map(|mut v| self.keep(&mut v.attrs).then_some(v))
+                .collect();
+            for variant in &mut item.variants {
+                self.fields(&mut variant.fields);
+            }
+            visit_mut::visit_item_enum_mut(self, item);
+        }
+        fn visit_expr_match_mut(&mut self, expr: &mut syn::ExprMatch) {
+            expr.arms.retain_mut(|arm| self.keep(&mut arm.attrs));
+            visit_mut::visit_expr_match_mut(self, expr);
+        }
+        fn visit_expr_struct_mut(&mut self, expr: &mut syn::ExprStruct) {
+            let fields = std::mem::take(&mut expr.fields);
+            expr.fields = fields
+                .into_iter()
+                .filter_map(|mut f| self.keep(&mut f.attrs).then_some(f))
+                .collect();
+            visit_mut::visit_expr_struct_mut(self, expr);
+        }
+        fn visit_signature_mut(&mut self, sig: &mut syn::Signature) {
+            let inputs = std::mem::take(&mut sig.inputs);
+            sig.inputs = inputs
+                .into_iter()
+                .filter_map(|mut arg| {
+                    let attrs = match &mut arg {
+                        syn::FnArg::Receiver(r) => &mut r.attrs,
+                        syn::FnArg::Typed(t) => &mut t.attrs,
