+    impl Trap {{ pub fn read(_: Trap) -> i32 {{ 0 }} }}
+    pub trait Reads {{ fn read(&self) -> i32; }}
+    impl Reads for Trap {{ fn read(&self) -> i32 {{ mark("read"); self.0 }} }}
+    pub fn trap(ok: bool) -> Result<Trap, &'static str> {{ mark("trap"); if ok {{ Ok(Trap(7)) }} else {{ Err("no trap") }} }}
